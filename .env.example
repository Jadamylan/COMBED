# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real keys.

# ── AI reasoning (Messages API) ─────────────────────────────────────────────
MODEL_API_KEY=
# Model name sent to the Messages API.
MODEL_NAME=claude-sonnet-4-5
# Override only if you use a different Messages-API-compatible endpoint.
MODEL_API_URL=https://api.anthropic.com/v1/messages

# ── Apify local-market signals ──────────────────────────────────────────────
APIFY_API_TOKEN=
# Actor ID in `username~actor-name` format. Swap this for the Actor you choose.
# The input builder for the Actor lives in lib/apify.js (APIFY_ACTOR config).
APIFY_ACTOR_ID=compass~crawler-google-places
# Keep this small for the hackathon — ~10 places keeps the live run fast.
APIFY_MAX_RESULTS=10
# Testing only: point the Apify call at a local stub instead of api.apify.com.
# APIFY_API_BASE=http://localhost:3299

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
